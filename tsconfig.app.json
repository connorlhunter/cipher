{
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "strict": true,
    "target": "ES2023"
  },
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"],
  "include": ["src"]
}
