{
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "strict": true,
    "target": "ES2023",
    "types": ["bun"]
  },
  "include": [
    "config/environment.ts",
    "scripts/change-naming.ts",
    "scripts/infra-control.ts",
    "scripts/infra-readiness.ts",
    "scripts/security/codeql-scan.ts",
    "scripts/toolchains.ts",
    "src/desktop.ts",
    "test/**/*.test.ts",
    "test/**/*.test.tsx"
  ]
}
