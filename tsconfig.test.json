{
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2023",
    "types": ["bun"]
  },
  "include": [
    "config/environment.ts",
    "scripts/build-server-image.ts",
    "scripts/change-naming.ts",
    "scripts/issue-link.ts",
    "scripts/coverage/**/*.ts",
    "scripts/changelog/**/*.ts",
    "scripts/publish/**/*.ts",
    "scripts/release/**/*.ts",
    "scripts/infra-control.ts",
    "scripts/infra-readiness.ts",
    "scripts/live-fixtures.ts",
    "scripts/security/codeql-scan.ts",
    "scripts/toolchains.ts",
    "src/desktop-contract.ts",
    "src/desktop.ts",
    "src/app/**/*.ts",
    "src/app/**/*.tsx",
    "src/components/**/*.ts",
    "src/components/**/*.tsx",
    "src/features/**/*.ts",
    "src/features/**/*.tsx",
    "src/lib/**/*.ts",
    "src/routes/**/*.ts",
    "src/routes/**/*.tsx",
    "src/renderer-data-lifetime.ts",
    "test/**/*.test.ts",
    "test/**/*.test.tsx"
  ]
}
