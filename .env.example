# Local runs bind to loopback. ECS sets this to 0.0.0.0:3000.
CIPHER_SERVER_BIND=127.0.0.1:3000

# Cipher has one production AWS environment in us-east-1.
CIPHER_AWS_REGION=us-east-1
CIPHER_AWS_ACCOUNT_ID=000000000000
CIPHER_API_ORIGIN=https://cipher.connorhunter.me
CIPHER_REALTIME_URL=wss://cipher.connorhunter.me/v1/realtime

# Replace these documentation values with the outputs of the production stack.
CIPHER_COGNITO_USER_POOL_ID=us-east-1_EXAMPLE123
CIPHER_COGNITO_CLIENT_ID=exampleclientid
CIPHER_USERS_TABLE=cipher-production-users
CIPHER_CONVERSATIONS_TABLE=cipher-production-conversations
CIPHER_MESSAGES_TABLE=cipher-production-messages
CIPHER_MEDIA_TABLE=cipher-production-media
CIPHER_MEDIA_BUCKET=cipher-production-example-media

RUST_LOG=cipher_server=info
