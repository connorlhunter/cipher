{
  "name": "cipher",
  "version": "0.1.0-prealpha.11",
  "description": "Secure realtime desktop messaging",
  "license": "MIT",
  "private": true,
  "repository": "https://github.com/connorlhunter/cipher",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14"
  },
  "toolchain": {
    "cargoLlvmCov": "0.8.7",
    "codeql": "2.26.3"
  },
  "scripts": {
    "audit": "bun audit --audit-level=high && cargo deny check",
    "bootstrap": "bun scripts/bootstrap.ts",
    "build": "bun run web:build && cargo build --workspace --locked",
    "codeql:scan": "bun scripts/security/codeql-scan.ts",
    "coverage:build": "bun run coverage:typescript && bun run coverage:rust && bun run coverage:render && bun run coverage:render:pdf",
    "coverage:publish": "bun run coverage:typescript && bun run coverage:rust && bun scripts/publish/publish-coverage.ts",
    "coverage:render": "bun scripts/coverage/render-coverage-report.ts",
    "coverage:render:pdf": "bun scripts/coverage/render-coverage-pdf.ts",
    "changelog:build": "bun scripts/changelog/changelog-artifact.ts",
    "changelog:publish": "bun scripts/publish/publish-changelog.ts",
    "coverage:typescript": "bun test test/*.test.ts test/*.test.tsx test/coverage/*.test.ts --coverage --timeout 30000 && bun scripts/coverage/check-typescript-coverage.ts",
    "coverage:rust": "bun scripts/coverage/run-rust-coverage.ts",
    "desktop:build": "bun scripts/run-tauri.ts build",
    "desktop:build:debug": "bun scripts/run-tauri.ts build --debug --bundles app",
    "desktop:dev": "bun scripts/run-tauri.ts dev",
    "check": "bun run check:frontend && cargo fmt --check && cargo clippy --workspace --all-targets -- -D warnings && npm --prefix infra run typecheck",
    "check:frontend": "vp check",
    "format": "vp fmt && cargo fmt",
    "format:check": "vp fmt --check && cargo fmt --check",
    "infra:install": "npm --prefix infra ci",
    "infra:destroy-all": "bun scripts/infra-control.ts destroy-all",
    "infra:certificate": "bun scripts/provision-production-certificate.ts",
    "live:fixtures": "bun scripts/live-fixtures.ts",
    "infra:pause": "bun scripts/infra-control.ts pause",
    "infra:readiness": "bun scripts/infra-readiness.ts",
    "infra:resume": "bun scripts/infra-control.ts resume",
    "infra:synth": "npm --prefix infra run synth",
    "lint": "vp lint && cargo clippy --workspace --all-targets -- -D warnings",
    "naming:check": "bun scripts/change-naming.ts --branch",
    "prepare": "bun scripts/setup-git-hooks.ts",
    "server:dev": "cargo run --locked -p cipher-server",
    "server:image": "bun scripts/build-server-image.ts",
    "test": "bun run test:frontend && bun run test:infra && bun run test:rust",
    "test:frontend": "bun test test/*.test.ts test/*.test.tsx test/coverage/*.test.ts",
    "test:infra": "npm --prefix infra run test",
    "test:rust": "cargo test --workspace --locked",
    "toolchain:check": "bun scripts/check-toolchain.ts",
    "typecheck": "vp check --no-fmt --no-lint && npm --prefix infra run typecheck",
    "release:publish": "bun run version:check && bun run coverage:typescript && bun run coverage:rust && bun scripts/release/publish-release-artifacts.ts",
    "version:check": "bun scripts/release-version.ts --check",
    "version:sync": "bun scripts/release-version.ts",
    "verify": "bun run naming:check && bun run version:check && bun run toolchain:check && bun run audit && bun run check && bun run test && bun run web:build && bun run codeql:scan",
    "web:build": "vp build",
    "web:dev": "vp dev"
  },
  "dependencies": {
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "@tauri-apps/api": "^2.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "marked": "^18.0.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/bun": "^1.4.0",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^6.1.1",
    "happy-dom": "^20.11.2",
    "pdfkit": "^0.19.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9",
    "vite-plus": "0.3.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9"
  }
}
