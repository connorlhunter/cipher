{
  "name": "cipher",
  "version": "0.1.0",
  "description": "Secure realtime desktop messaging",
  "license": "MIT",
  "private": true,
  "repository": "https://github.com/connorlhunter/cipher",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14"
  },
  "scripts": {
    "audit": "bun audit --audit-level=high && cargo deny check advisories licenses sources",
    "bootstrap": "bun scripts/bootstrap.ts",
    "build": "bun run web:build && cargo build --workspace --locked",
    "desktop:build": "bun scripts/run-tauri.ts build",
    "desktop:build:debug": "bun scripts/run-tauri.ts build --debug --bundles app",
    "desktop:dev": "bun scripts/run-tauri.ts dev",
    "format": "bun x prettier --write . --ignore-unknown && cargo fmt",
    "format:check": "bun x prettier --check . --ignore-unknown && cargo fmt --check",
    "infra:install": "npm --prefix infra ci",
    "infra:destroy-all": "bun scripts/infra-control.ts destroy-all",
    "infra:pause": "bun scripts/infra-control.ts pause",
    "infra:readiness": "bun scripts/infra-readiness.ts",
    "infra:resume": "bun scripts/infra-control.ts resume",
    "infra:synth": "npm --prefix infra run synth",
    "lint": "bun x eslint . && cargo clippy --workspace --all-targets -- -D warnings",
    "prepare": "bun scripts/setup-git-hooks.ts",
    "server:dev": "cargo run --locked -p cipher-server",
    "test": "bun run test:frontend && bun run test:rust",
    "test:frontend": "bun test",
    "test:rust": "cargo test --workspace --locked",
    "toolchain:check": "bun scripts/check-toolchain.ts",
    "typecheck": "bun x tsc --build --pretty false",
    "verify": "bun run toolchain:check && bun run audit && bun run format:check && bun run lint && bun run typecheck && bun run test && bun run web:build",
    "web:build": "vite build",
    "web:dev": "vite"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.11.4",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "lint-staged": "17.2.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.1"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "bun x prettier --write",
      "bun x eslint --fix"
    ],
    "*.{css,html,json,yml,yaml}": [
      "bun x prettier --write"
    ],
    "*.rs": [
      "cargo fmt --"
    ]
  }
}
