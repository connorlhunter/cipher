{
  "name": "cipher",
  "version": "0.1.0-prealpha.4",
  "description": "Secure realtime desktop messaging",
  "license": "MIT",
  "private": true,
  "repository": "https://github.com/connorlhunter/cipher",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14"
  },
  "toolchain": {
    "cargoLlvmCov": "0.8.7",
    "codeql": "2.26.3"
  },
  "scripts": {
    "audit": "bun audit --audit-level=high && cargo deny check",
    "bootstrap": "bun scripts/bootstrap.ts",
    "build": "bun run web:build && cargo build --workspace --locked",
    "codeql:scan": "bun scripts/security/codeql-scan.ts",
    "coverage:build": "bun run coverage:typescript && bun run coverage:rust && bun run coverage:render && bun run coverage:render:pdf",
    "coverage:publish": "bun run coverage:typescript && bun run coverage:rust && bun scripts/publish/publish-coverage.ts",
    "coverage:render": "bun scripts/coverage/render-coverage-report.ts",
    "coverage:render:pdf": "bun scripts/coverage/render-coverage-pdf.ts",
    "coverage:typescript": "bun test test/*.test.ts test/coverage/*.test.ts --coverage --timeout 30000 && bun scripts/coverage/check-typescript-coverage.ts",
    "coverage:rust": "bun scripts/coverage/run-rust-coverage.ts",
    "desktop:build": "bun scripts/run-tauri.ts build",
    "desktop:build:debug": "bun scripts/run-tauri.ts build --debug --bundles app",
    "desktop:dev": "bun scripts/run-tauri.ts dev",
    "format": "bun x prettier --write . --ignore-unknown && cargo fmt",
    "format:check": "bun x prettier --check . --ignore-unknown && cargo fmt --check",
    "infra:install": "npm --prefix infra ci",
    "infra:destroy-all": "bun scripts/infra-control.ts destroy-all",
    "live:fixtures": "bun scripts/live-fixtures.ts",
    "infra:pause": "bun scripts/infra-control.ts pause",
    "infra:readiness": "bun scripts/infra-readiness.ts",
    "infra:resume": "bun scripts/infra-control.ts resume",
    "infra:synth": "npm --prefix infra run synth",
    "lint": "bun x eslint . && cargo clippy --workspace --all-targets -- -D warnings",
    "naming:check": "bun scripts/change-naming.ts --branch",
    "prepare": "bun scripts/setup-git-hooks.ts",
    "server:dev": "cargo run --locked -p cipher-server",
    "server:image": "bun scripts/build-server-image.ts",
    "test": "bun run test:frontend && bun run test:infra && bun run test:rust",
    "test:frontend": "bun test test/*.test.ts test/coverage/*.test.ts",
    "test:infra": "npm --prefix infra run test",
    "test:rust": "cargo test --workspace --locked",
    "toolchain:check": "bun scripts/check-toolchain.ts",
    "typecheck": "bun x tsgo --build --pretty false && npm --prefix infra run typecheck",
    "version:check": "bun scripts/release-version.ts --check",
    "version:sync": "bun scripts/release-version.ts",
    "verify": "bun run naming:check && bun run version:check && bun run toolchain:check && bun run audit && bun run codeql:scan && bun run format:check && bun run lint && bun run typecheck && bun run test && bun run web:build",
    "web:build": "vite build",
    "web:dev": "vite"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.4",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "puppeteer": "^25.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.1"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "bun x prettier --write",
      "bun x eslint --fix"
    ],
    "*.{css,html,json,yml,yaml}": [
      "bun x prettier --write"
    ],
    "*.rs": [
      "cargo fmt --"
    ]
  }
}
